# Copy to .env and fill in your values:  cp .env.example .env
# .env is gitignored and never committed. The app loads it at startup
# (app/config.py, load_dotenv); variables already set in the shell
# always win over .env, so an inline export still overrides this file.
# Run uvicorn from this repo root so the .env file is found.

# Full path to your rollup_poc_base.sqlite (table dyad_status_rollup).
# For the September snapshot, point this at your relabeled (hot-first,
# build a3d9769) copy; with ROLLUP_SQLITE unset the app still starts
# but the data endpoints return 503.
ROLLUP_SQLITE=/path/to/rollup_poc_base.sqlite

# Optional: full path to your rollup_predictive.sqlite (the set-share
# predictive build). When set, rollup rows are served with the
# validated two-set exceedance attached (exc45_max / exc45_max_set)
# alongside the legacy max_exc45 fields; when unset, rows are served
# exactly as before.
PREDICTIVE_SQLITE=/path/to/rollup_predictive.sqlite

# strict (default, fail closed on version mismatch) or warn.
API_VERSION_MODE=strict

# DEV ONLY (dev line; not part of the v1 contract).
# DDA sidecar SQLite (built by tools/build_dda_sidecar.py) and the
# CAMEO-sets JSON (analytics repo data-refs/cameo_groups.json).
# Either unset means the /dev/dda-* endpoints return 503.
DDA_SQLITE=/path/to/dda_poc_base.sqlite
DDA_SETS_JSON=/path/to/cameo_groups.json

# CAMEO-simplexes JSON (cameo_tokens.json). The daily/codes dev
# endpoints read this file as a CODE LIST (mapped set = codes
# present in the file, verified = soc_long's 318); /dev/dda-joint
# additionally reads its simplex p-values (Dan, 2026-10-28 —
# simplex extension started in dev). The file is the source
# because Dan named it; soc_long as the simplex source is still
# his confirmation to give (tokens carries values for 41 codes
# where soc_long is NULL).
DDA_SIMPLEXES_JSON=/path/to/cameo_tokens.json

# poc_base mirror SQLite (built by the data-platform repo's
# tools/build_sqlite_mirror.py). Read by the dev endpoints that
# work from the mirror rather than the rollup or sidecar:
# /dev/health (cross-store checks), /dev/country-aggregates
# (country polygons for the choropleths), and /dev/event-detail
# (event-level aggregates; that endpoint also needs
# DDA_SIMPLEXES_JSON for its Lund compositions). Unset means
# those endpoints return 503. A relative path resolves against
# the directory uvicorn was started from — an absolute path is
# safer.
MIRROR_SQLITE=/path/to/poc_base.sqlite

# Optional safety valve for /dev/event-detail and
# /dev/event-detail/group (DEV only): the maximum event
# rows one call will process for a dyad's 28-day slice.
# Over the cap, the endpoints refuse with a 503 naming
# the counts instead of grinding until the client times
# out. Leave unset (or 0) for no cap. Set it on hosts
# weaker than the one the mirror usually runs on.
# EVENT_DETAIL_MAX_EVENTS=200000
