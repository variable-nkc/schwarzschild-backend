# Copy to .env and fill in your values:  cp .env.example .env
# .env is gitignored and never committed. The app loads it at startup
# (app/config.py, load_dotenv); variables already set in the shell
# always win over .env, so an inline export still overrides this file.
# Run uvicorn from this repo root so the .env file is found.

# Full path to your rollup_poc_base.sqlite (table dyad_status_rollup).
# For the September snapshot, point this at your relabeled (hot-first,
# build a3d9769) copy; with ROLLUP_SQLITE unset the app still starts
# but the data endpoints return 503.
ROLLUP_SQLITE=/path/to/rollup_poc_base.sqlite

# strict (default, fail closed on version mismatch) or warn.
API_VERSION_MODE=strict

# DEV ONLY (dev/dda-sidecar branch; not part of the v1 contract).
# DDA sidecar SQLite (built by tools/build_dda_sidecar.py) and the
# CAMEO-sets JSON (analytics repo data-refs/cameo_groups.json).
# Either unset means the /dev/dda-* endpoints return 503.
DDA_SQLITE=/path/to/dda_poc_base.sqlite
DDA_SETS_JSON=/path/to/cameo_groups.json

# FUTURE DEVELOPMENT ONLY — not currently used by any endpoint.
# Prepared env surface for the simplex extension: the intended
# source is cameo_tokens.json, pending Dan's confirmation of the
# soc_long table as the simplex source. No endpoint reads this
# variable today; round 1 uses membership-based set shares only.
DDA_SIMPLEXES_JSON=/path/to/cameo_tokens.json
